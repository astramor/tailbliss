{
  "name": "TailBliss",
  "version": "0.6.1",
  "description": "Hugo + Alpine.js + TailwindCSS",
  "devDependencies": {
    "@iconify-json/ic": "^1.2.2",
    "@iconify-json/material-symbols": "^1.2.20",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.5",
    "@iconify/json": "^2.2.325",
    "@iconify/tailwind": "^1.2.0",
    "@iconify/tools": "^4.1.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/postcss": "^4.1.5",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.0",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^4.1.5"
  },
  "dependencies": {
    "@iconify/icons-material-symbols": "^1.2.58",
    "@iconify/icons-mdi": "^1.2.48",
    "@iconify/icons-ph": "^1.2.5",
    "@iconify/icons-ri": "^1.2.10",
    "alpinejs": "^3.14.9",
    "leaflet": "^1.9.4"
  },
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./assets/css/main.css -o ./static/css/style.css --watch",
    "hugo:serve": "hugo server -D --bind=192.168.178.75 --baseURL=\"http://192.168.178.75:1313/\"",
    "start": "npm-run-all --parallel watch:css hugo:serve",
    "clean": "rm -rf public/*",
    "build": "npm run clean && npm run build:css && hugo --gc --minify",
    "test": "hugo"
  }
}
