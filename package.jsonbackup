{
  "name": "TailBliss",
  "version": "0.6.1",
  "description": "Hugo + Alpine.js + TailwindCSS",
  "main": "index.js",
  "type": "module",
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.5",
    "@iconify/json": "^2.2.325",
    "@iconify/tailwind": "^1.2.0",
    "@iconify/tools": "^4.1.2",
    "@tailwindcss/postcss": "^4.1.3",
    "@tailwindcss/typography": "^0.5.15",
    "alpinejs": "^3.14.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "hugo-extended": "^0.145.0",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.0",
    "rimraf": "^5.0.10",
    "tailwindcss": "^4.1.3"
  },
  "dependencies": {
    "@iconify/icons-material-symbols": "^1.2.58",
    "@iconify/icons-mdi": "^1.2.48",
    "@iconify/icons-ph": "^1.2.5",
    "@iconify/icons-ri": "^1.2.10",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "material-design-icons-iconfont": "^6.7.0",
    "material-symbols": "^0.27.2"
  },
 "scripts": {
    "dev": "concurrently npm:watch:*",
    "watch:tw": "tailwindcss -i ./assets/css/main.css -o ./assets/css/style.css --watch --poll",
    "watch:hugo": "hugo server -D --poll 700ms",
    "clean": "rimraf static/js/* public/*",
    "build": "npm run clean && npm run build:hugo",
    "build:hugo": "hugo --minify",
    "test": "hugo"
  }
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nusserstudios/tailbliss.git"
  },
  "keywords": [
    "hugo",
    "tailwind",
    "tailwindcss",
    "alpinejs",
    "minimal",
    "responsive",
    "light mode",
    "dark mode",
    "hugo blog",
    "categories",
    "tags"
  ],
  "author": "NusserStudios",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nusserstudios/tailbliss/issues"
  },
  "homepage": "https://github.com/nusserstudios/tailbliss"
}
